# ==========================================
# Acadex Environment Configuration Template
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=acadexdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend API Configuration (ASP.NET Core Web API)
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=Acadex_SuperSecret_Jwt_Security_Key_2026_Minimum32Characters!
JWT_ISSUER=AcadexApi
JWT_AUDIENCE=AcadexClient

# Frontend Configuration (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
